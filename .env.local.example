# Supabase
# 公開サイト・管理画面のクライアントから使用（公開可）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# サーバーサイド専用。絶対にクライアントへ露出させない
SUPABASE_SERVICE_ROLE_KEY=

# AI API（記事生成）
ANTHROPIC_API_KEY=

# Google Gemini / Nano Banana（表紙サムネ図解。未設定ならグラデフォールバック）
GEMINI_API_KEY=
# 任意: 既定は gemini-3.1-flash-image（Nano Banana 2）
# NANOBANANA_MODEL=gemini-3.1-flash-image

# xAI Grok（管理画面のSNSトレンド候補取得。未設定なら更新ボタンはエラー）
XAI_API_KEY=

# 通知（Slack Incoming Webhook）
SLACK_WEBHOOK_URL=

# サイトの公開URL（OGP・sitemap・構造化データで使用）
NEXT_PUBLIC_SITE_URL=

# ---- ニュースRSS（npm run fetch-news / GitHub Actions） ----
# Googleニュース取得のON/OFF。未設定または true で取得する。
# 利用規約やノイズが気になる場合は false にして、国交省・産廃ニュースのみにする。
# NEWS_ENABLE_GOOGLE_NEWS=false
# 自社解説文の生成には ANTHROPIC_API_KEY が必要（未設定ならRSS保存のみ）。
